# Результаты (можно загружать, но лучше исключить большие файлы)
results/*.txt
results/*.csv
results/*.xlsx
!results/.gitkeep
!results/comparison_table.csv

# Графики (можно загружать, но лучше исключить)
figures/*.png
figures/*.jpg
figures/*.pdf
figures/*.svg
!figures/.gitkeep
!figures/residuals_diagnostics.png

